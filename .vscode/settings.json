// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "out": false,
        "**/*.rpyc": true,
        "**/*.rpa": true,
        "**/*.rpymc": true,
        "**/cache/": true,
        "**/.circleci": true,
        "**/.compodocrc*": true,
        "**/.editorconfig": true,
        "**/.gitattributes": true,
        "**/.github": true,
        "**/.gitkeep": true,
        "**/.gitignore": true,
        "**/.npmrc": true,
        "**/.prettierignore": true,
        "**/.prettierrc*": true,
        "**/.scannerwork": true,
        "**/.eslint*": true,
        "**/.docker*": true,
        "**/docker": true,
        "**/.nvmrc": true,
        "**/.vscodeignore": true,
        "**/.vscode": true,
        "**/CHANGELOG.md": true,
        "**/README.md": true,
        "**/LICENSE.md": true,
        "**/angular.json": true,
        "**/workspace.json": true,
        "**/jest-mocks.ts": true,
        "**/jest.config.js": true,
        "**/jest.preset.js": true,
        "**/node_modules": true,
        "**/nx.json": true,
        "**/package-lock.json": true,
        "**/package.json": true,
        "**/sonar-project.properties": true,
        "**/tsconfig*": true,
        "**/tslint*": true,
        "**/babel*": true,
        "**/.babel*": true,
        "**/webpack*": true,
        "**/typings.d.ts": true,
        "**/*.yaml": true,
        "**/Makefile": true,
        "**/*.sh": true
    },
    "search.exclude": {
        "out": true // set this to false to include "out" folder in search results
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "typescript.tsc.autoDetect": "off"
}